# ---------- Required ----------
# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=your_token_here
# From Google AI Studio (used for scoring + news keywords)
GEMINI_API_KEY=your_gemini_key_here

# ---------- Recommended ----------
# Claude writes the drafts (holds Meera's voice better).
# If left empty, Gemini writes the drafts instead.
ANTHROPIC_API_KEY=

# ---------- Optional: memory (notes, drafts, APPROVE/REJECT) ----------
# e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Supabase -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_KEY=

# ---------- Optional: security ----------
# Only these Telegram chat IDs may use the bot (comma-separated). Empty = anyone.
ALLOWED_CHAT_IDS=
# Any random string. Pass the same value as secret_token when you set the webhook.
TELEGRAM_WEBHOOK_SECRET=

# ---------- Optional: tuning ----------
# Notes scoring at or above this get drafted
MIN_SCORE=6
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-sonnet-5
